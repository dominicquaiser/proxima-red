# nginx site config. The official nginx image renders this template at startup,
# substituting only ${DOMAIN} (NGINX_ENVSUBST_FILTER=DOMAIN keeps nginx's own
# $variables intact).

# WebSocket upgrade handling for the live-note sync socket (/ws/): forward the
# client's Upgrade intent, close the connection when there is none.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Default servers: reject any request whose Host/SNI isn't one we serve before
# it reaches Django.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# HTTP: serve ACME http-01 challenges, redirect everything else to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN} pass.${DOMAIN} note.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: serve the application.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} pass.${DOMAIN} note.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # No file uploads in this app; keep request bodies small.
    client_max_body_size 2m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 256;

    # Static files collected into the shared volume.
    location /static/ {
        alias /app/staticfiles/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Use Docker's internal DNS so nginx re-resolves the upstream IP on each
    # config reload rather than caching it at startup (avoids 502s after
    # container restarts where the web service gets a new IP).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # WebSockets (live-note sync). proxy_read/send_timeout must exceed the
    # client's 20s awareness keepalive so idle-but-healthy sockets stay open.
    location /ws/ {
        set $upstream http://web:8000;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_redirect off;
    }

    # Everything else is proxied to the app server.
    location / {
        set $upstream http://web:8000;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
