# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# Generate a strong SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated. All domains must be listed.
ALLOWED_HOSTS=proxima.red,pass.proxima.red,note.proxima.red
# Comma-separated, scheme-qualified. Required by Django for cross-origin POSTs
# (e.g. the sign-out form on pass.proxima.red posts to proxima.red).
CSRF_TRUSTED_ORIGINS=https://proxima.red,https://pass.proxima.red,https://note.proxima.red

# Canonical base URLs for the per-tool domains (no trailing slash).
# Used for sitemaps, robots.txt, and cross-domain links in templates.
SITE_URL=https://proxima.red
PASS_SITE_URL=https://pass.proxima.red
NOTE_SITE_URL=https://note.proxima.red

# Share the session cookie across both subdomains so a user who signs in on
# proxima.red can access their vault on pass.proxima.red without re-authenticating.
SESSION_COOKIE_DOMAIN=.proxima.red

# DJANGO_SETTINGS_MODULE is set per-service by the compose files
# (development vs production), so it does not need to be set here.

# --- Database ---
# Used by the postgres container...
POSTGRES_DB=proximared
POSTGRES_USER=proximared
POSTGRES_PASSWORD=change-me
# ...and by Django (host = the compose service name "db").
DATABASE_URL=postgres://proximared:change-me@db:5432/proximared
# Max age of database connections in seconds (production only, default 60).
# CONN_MAX_AGE=60

# --- TLS / nginx (production) ---
# Primary domain - Nginx uses this for the certificate and default vhost.
DOMAIN=proxima.red
CERTBOT_EMAIL=you@example.com

# Number of trusted reverse proxies in front of the app, used to read the real
# client IP from X-Forwarded-For for rate limiting. Production defaults to 1
# (nginx). Raise it by one for each extra proxy you add in front (e.g. a load
# balancer or Cloudflare); setting it too high lets clients spoof their IP.
# RATELIMIT_TRUSTED_PROXY_COUNT=1

# --- gunicorn (optional) ---
# Defaults to (2 * CPU cores) + 1 if unset.
# GUNICORN_WORKERS=3
# Worker timeout in seconds (default 60).
# GUNICORN_TIMEOUT=60
